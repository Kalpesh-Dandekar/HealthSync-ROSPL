generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  CAREGIVER
  PHYSICIAN
}

enum MedicationStatus {
  TAKEN
  MISSED
  PENDING
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ClinicalRecordType {
  CONSULTATION
  VITAL_ASSESSMENT
  LAB_RESULT
  FOLLOW_UP
  GENERAL_NOTE
}

enum ClinicalRecordStatus {
  NORMAL
  NEEDS_ATTENTION
  CRITICAL
}

enum VitalSource {
  PATIENT
  PHYSICIAN
  CAREGIVER
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id                          Int                                 @id @default(autoincrement())
  name                        String
  email                       String                              @unique
  password                    String
  role                        UserRole                            @default(PATIENT)
  createdAt                   DateTime                            @default(now())
  medications                 Medication[]
  medicationLogs              MedicationLog[]
  vitals                      Vital[]                             @relation("PatientVitals")
  recordedVitals              Vital[]                             @relation("RecordedVitals")
  patientAppointments         Appointment[]                       @relation("PatientAppointments")
  physicianAppointments       Appointment[]                       @relation("PhysicianAppointments")
  physicianAvailability       PhysicianAvailability[]
  physicianUnavailablePeriods PhysicianUnavailablePeriod[]
  patientClinicalRecords      ClinicalRecord[]                    @relation("PatientClinicalRecords")
  authoredClinicalRecords     ClinicalRecord[]                    @relation("PhysicianClinicalRecords")
  alerts                      Alert[]
  patientConnections          CareConnection[]                    @relation("PatientConnections")
  caregiverConnections        CareConnection[]                    @relation("CaregiverConnections")
  physicianConnections        CareConnection[]                    @relation("PhysicianConnections")
  patientPhysicianRequests    PhysicianConnectionRequest[]        @relation("RequestPatient")
  physicianConnectionRequests PhysicianConnectionRequest[]        @relation("RequestPhysician")
  sentConnectionRequests      PhysicianConnectionRequest[]        @relation("RequestSender")
  receivedConnectionRequests  PhysicianConnectionRequest[]        @relation("RequestRecipient")
  caregiverInvites            CaregiverInvite[]
  patientEmergencies          Emergency[]                         @relation("PatientEmergencies")
  triggeredEmergencies        Emergency[]                         @relation("TriggeredEmergencies")
  respondingEmergencies       Emergency[]                         @relation("RespondingEmergencies")
  resolvedEmergencies         Emergency[]                         @relation("ResolvedEmergencies")
  emergencyAcknowledgements   EmergencyCaregiverAcknowledgement[]
}

model Medication {
  id        Int             @id @default(autoincrement())
  userId    Int
  name      String
  dosage    String
  schedule  String
  stock     Int             @default(0)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      MedicationLog[]
}

model MedicationLog {
  id           Int              @id @default(autoincrement())
  medicationId Int
  userId       Int
  status       MedicationStatus @default(PENDING)
  scheduledAt  DateTime
  takenAt      DateTime?
  medication   Medication       @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vital {
  id           Int          @id @default(autoincrement())
  userId       Int
  recordedById Int?
  source       VitalSource?
  heartRate    Int?
  systolic     Int?
  diastolic    Int?
  glucose      Float?
  recordedAt   DateTime     @default(now())
  user         User         @relation("PatientVitals", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("RecordedVitals", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([recordedById])
}

model Appointment {
  id              Int               @id @default(autoincrement())
  userId          Int
  physicianId     Int?
  title           String
  doctor          String
  date            String
  time            String
  scheduledAt     DateTime?
  durationMinutes Int               @default(30)
  reason          String?
  status          AppointmentStatus @default(REQUESTED)
  activeSlotKey   String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation("PatientAppointments", fields: [userId], references: [id], onDelete: Cascade)
  physician       User?             @relation("PhysicianAppointments", fields: [physicianId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledAt])
  @@index([physicianId, scheduledAt])
  @@index([status, scheduledAt])
}

model PhysicianAvailability {
  id           Int    @id @default(autoincrement())
  physicianId  Int
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int    @default(30)
  physician    User   @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@unique([physicianId, dayOfWeek])
  @@index([physicianId])
}

model PhysicianUnavailablePeriod {
  id          Int      @id @default(autoincrement())
  physicianId Int
  startDate   String
  endDate     String
  reason      String?
  createdAt   DateTime @default(now())
  physician   User     @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId, startDate, endDate])
}

model ClinicalRecord {
  id               Int                  @id @default(autoincrement())
  patientId        Int
  physicianId      Int
  type             ClinicalRecordType
  title            String
  clinicalDate     DateTime             @db.Date
  findings         String               @db.Text
  interpretation   String               @db.Text
  recommendations  String               @db.Text
  status           ClinicalRecordStatus @default(NORMAL)
  followUpRequired Boolean              @default(false)
  followUpDate     DateTime?            @db.Date
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  patient          User                 @relation("PatientClinicalRecords", fields: [patientId], references: [id], onDelete: Cascade)
  physician        User                 @relation("PhysicianClinicalRecords", fields: [physicianId], references: [id], onDelete: Restrict)

  @@index([patientId, clinicalDate])
  @@index([physicianId, clinicalDate])
  @@index([status, clinicalDate])
}

model Alert {
  id        Int           @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  severity  AlertSeverity @default(INFO)
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareConnection {
  id          Int      @id @default(autoincrement())
  patientId   Int
  caregiverId Int?
  physicianId Int?
  createdAt   DateTime @default(now())
  patient     User     @relation("PatientConnections", fields: [patientId], references: [id], onDelete: Cascade)
  caregiver   User?    @relation("CaregiverConnections", fields: [caregiverId], references: [id], onDelete: SetNull)
  physician   User?    @relation("PhysicianConnections", fields: [physicianId], references: [id], onDelete: SetNull)

  @@unique([patientId, caregiverId])
  @@unique([patientId, physicianId])
  @@index([caregiverId])
  @@index([physicianId])
}

model PhysicianConnectionRequest {
  id          Int                     @id @default(autoincrement())
  patientId   Int
  physicianId Int
  senderId    Int
  recipientId Int
  status      ConnectionRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  patient     User                    @relation("RequestPatient", fields: [patientId], references: [id], onDelete: Cascade)
  physician   User                    @relation("RequestPhysician", fields: [physicianId], references: [id], onDelete: Cascade)
  sender      User                    @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                    @relation("RequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([patientId, physicianId])
  @@index([recipientId, status])
  @@index([senderId, status])
}

model CaregiverInvite {
  id         Int       @id @default(autoincrement())
  patientId  Int       @unique
  codeHash   String    @unique
  codeHint   String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
  patient    User      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Emergency {
  id                        Int                                 @id @default(autoincrement())
  patientId                 Int
  triggeredById             Int
  triggeredByRole           UserRole
  status                    EmergencyStatus                     @default(ACTIVE)
  respondingPhysicianId     Int?
  acknowledgedAt            DateTime?
  resolvedById              Int?
  resolvedAt                DateTime?
  resolutionNote            String?                             @db.Text
  activePatientKey          Int?                                @unique
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  patient                   User                                @relation("PatientEmergencies", fields: [patientId], references: [id], onDelete: Cascade)
  triggeredBy               User                                @relation("TriggeredEmergencies", fields: [triggeredById], references: [id], onDelete: Restrict)
  respondingPhysician       User?                               @relation("RespondingEmergencies", fields: [respondingPhysicianId], references: [id], onDelete: SetNull)
  resolvedBy                User?                               @relation("ResolvedEmergencies", fields: [resolvedById], references: [id], onDelete: SetNull)
  caregiverAcknowledgements EmergencyCaregiverAcknowledgement[]

  @@index([status, createdAt])
  @@index([patientId, createdAt])
  @@index([respondingPhysicianId, status])
}

model EmergencyCaregiverAcknowledgement {
  id             Int       @id @default(autoincrement())
  emergencyId    Int
  caregiverId    Int
  acknowledgedAt DateTime  @default(now())
  emergency      Emergency @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  caregiver      User      @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  @@unique([emergencyId, caregiverId])
  @@index([caregiverId, acknowledgedAt])
}
